# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# Isolated, retained P1 check runs (build output and test copies)
/.checks/

# Python integration-check bytecode (checks themselves disable new writes)
/tests/__pycache__/
